# ── Telegram ─────────────────────────────────────────────
# @BotFather -> /newbot gives the token. @userinfobot gives your numeric user ID.
TELEGRAM_BOT_TOKEN=123456789:AA...
ALLOWED_USER_IDS=111111111          # comma-separate for more people; everyone else is ignored

# ── Claude auth ──────────────────────────────────────────
# Pro/Max + Chrome box: leave BOTH empty and sign in once with `claude` -> /login
# (Chrome integration is OFF when a token or API key is used).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_CLI_PATH=                    # empty = the `claude` on PATH (shares /login, MCP servers, Chrome)

# ── Workspace ────────────────────────────────────────────
BASE_DIR=C:\bounty                  # targets, scope, findings, tools and CLAUDE.md live here
DEFAULT_MODEL=sonnet                # opus | sonnet | haiku | full id
DEFAULT_EFFORT=high                 # low | medium | high | xhigh | max
DEFAULT_MODE=default                # default | acceptEdits | plan | bypassPermissions

# ── Chrome / Burp ────────────────────────────────────────
ENABLE_CHROME=1                     # 1 = drive Chrome via the Claude extension
AUTO_ALLOW_TOOLS=mcp__claude-in-chrome__*,mcp__burp__*   # tools that never prompt (trailing * = prefix)

# ── Autonomy & resilience ────────────────────────────────
AUTOPILOT_MAX_STEPS=40              # self-directed steps before autopilot pauses for you
AUTOPILOT_DELAY_SEC=4
AUTOPILOT_BUDGET_USD=0              # 0 = no cap (only meaningful on API billing)
RESUME_POLL_SEC=900                # how often to recheck when a usage limit has no reset time
RESUME_BUFFER_SEC=45               # wait this long past a limit reset before retrying
RECOVER_MAX=3                      # consecutive auto-restarts on error before giving up
RECOVER_DELAY_SEC=5

# ── Misc ─────────────────────────────────────────────────
MAX_BUDGET_PER_TURN_USD=0
APPROVAL_TIMEOUT_SEC=600
SH_TIMEOUT_SEC=300
